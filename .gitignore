# Node.js web project
web/node_modules/
web/dist/
web/build/
web/coverage/
web/.cache/
web/.npm/
.cloakbrowser/
.user_data/
web/.eslintcache
web/*.tsbuildinfo
web/.env
web/.env.*
!web/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python bytecode (written next to skill and build scripts that import their siblings)
__pycache__/
*.pyc

# godot-cpp build intermediates (shared libraries under cpp/bin/ are kept)
cpp/**/*.obj
cpp/**/*.os
cpp/**/*.o
cpp/**/*.a
cpp/**/*.lib
cpp/**/*.exp
cpp/**/*.ilk
cpp/**/*.pdb
cpp/.sconsign.dblite
cpp/.sconsign.dblite.*
# Godot GDExtension hot-reload temp copies (e.g. ~gai_cpp.windows....dll)
cpp/bin/**/~*

# Godot 4+ specific ignores
.godot/**
!.godot/extension_list.cfg
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Temporary files and directories
*.tmp
*.tmp.*
*.temp
*.temp.*
.tmp*/
tmp*/
.temp*/
temp*/
