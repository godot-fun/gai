[gd_scene format=3]

[ext_resource type="Script" path="res://agent/test/VLMBenchmarkTest.gd" id="1"]

[node name="VLMBenchmarkTest" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Vision Language Model Benchmark（视觉大模型耗时测试）"

[node name="Description" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "Compare end-to-end CLI vision, HTTP vision, and HTTP text-only LLM request times on the same MiniCPM-V server. The first HTTP request includes server startup; subsequent requests reuse the resident model."
autowrap_mode = 3

[node name="CliRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="CliButton" type="Button" parent="Margin/Content/CliRow"]
custom_minimum_size = Vector2(260, 48)
layout_mode = 2
text = "Full CLI Request"

[node name="CliTime" type="Label" parent="Margin/Content/CliRow"]
layout_mode = 2
text = "Not Run Yet"

[node name="HttpRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="HttpButton" type="Button" parent="Margin/Content/HttpRow"]
custom_minimum_size = Vector2(260, 48)
layout_mode = 2
text = "Full HTTP Image Request"

[node name="HttpTime" type="Label" parent="Margin/Content/HttpRow"]
layout_mode = 2
text = "Not Run Yet"

[node name="LlmRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="LlmButton" type="Button" parent="Margin/Content/LlmRow"]
custom_minimum_size = Vector2(260, 48)
layout_mode = 2
text = "Full HTTP LLM Request"

[node name="LlmTime" type="Label" parent="Margin/Content/LlmRow"]
layout_mode = 2
text = "Not Run Yet"

[node name="LlmZhRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="LlmZhButton" type="Button" parent="Margin/Content/LlmZhRow"]
custom_minimum_size = Vector2(260, 48)
layout_mode = 2
text = "完整 HTTP 中文 LLM 请求"

[node name="LlmZhTime" type="Label" parent="Margin/Content/LlmZhRow"]
layout_mode = 2
text = "尚未运行"

[node name="EnglishTokenizeRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="EnglishTokenizeButton" type="Button" parent="Margin/Content/EnglishTokenizeRow"]
custom_minimum_size = Vector2(260, 48)
layout_mode = 2
text = "Tokenize English Prompt"

[node name="EnglishTokenizeTime" type="Label" parent="Margin/Content/EnglishTokenizeRow"]
layout_mode = 2
text = "Not Run Yet"

[node name="ChineseTokenizeRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="ChineseTokenizeButton" type="Button" parent="Margin/Content/ChineseTokenizeRow"]
