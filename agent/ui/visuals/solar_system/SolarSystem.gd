class Planet extends RefCounted:
	var pivot: Node3D
	var anchor: Node3D
	var body: MeshInstance3D
	var body_material: ShaderMaterial
	var atmosphere_material: ShaderMaterial
	var cloud_material: ShaderMaterial
	var halo: Sprite3D
	var radius: float = 0.2
	var orbit_angle: float = 0.0
	var orbit_speed: float = 0.2
	var axis_spin: float = 0.5
	var flash: float = 0.0
	var flash_color: Color = Color.WHITE
	var halo_target: float = 0.0
	var halo_energy: float = 0.0


## A tool's spacecraft: travels from the star to its planet, then circles it until the tool ends.
class Probe extends RefCounted:
	var sprite: Sprite3D
	var planet: int = 0
	var color: Color = Color.WHITE
	var progress: float = 0.0
	var orbit_angle: float = 0.0
	var trail_clock: float = 0.0


class Burst extends RefCounted:
	var sprite: Sprite3D
	var life: float = 0.0
	var duration: float = 0.6
	var start_scale: float = 0.6
	var end_scale: float = 2.0
	var color: Color = Color.WHITE


var overlay: Control
var container: SubViewportContainer
var viewport: SubViewport
var environment: Environment
var camera: Camera3D
var system_root: Node3D
var effects_root: Node3D
var belt_root: MultiMeshInstance3D

var sun_body: MeshInstance3D
var sun_body_material: ShaderMaterial
var sun_corona: MeshInstance3D
var sun_corona_material: ShaderMaterial
var sun_glow: Sprite3D
var starfield_material: ShaderMaterial
var fill_light: DirectionalLight3D
var belt_material: StandardMaterial3D
var unit_sphere: SphereMesh
var glow_texture: ImageTexture
var halo_texture: ImageTexture

var planets: Array[Planet] = []
## Orbit planes and radii feed [constant ORBITS_SHADER]; the sampled paths only size its per-ring
## screen bounding boxes so pixels outside every ring skip the ray maths.
var orbit_normals := PackedVector3Array()
var orbit_radii := PackedFloat32Array()
var orbit_paths: Array[PackedVector3Array] = []
var orbit_layer: ColorRect
var orbit_material: ShaderMaterial
var orbit_camera_synced: bool = false
var probes: Dictionary[String, Probe] = {}
var bursts: Array[Burst] = []
var tool_planets: Dictionary[String, int] = {}
var rng := RandomNumberGenerator.new()

var ending: bool = false
var clock: float = 0.0
var energy: float = 0.0
var target_energy: float = 0.0
var sun_flare: float = 0.0
var orbit_gain: float = 1.0
var spark_charge: float = 0.0
var focus_index: int = 0
var next_tool_planet: int = 0
var belt_angle: float = 0.0


func _ready() -> void:
	super._ready()
	ensure_system()
	pass


func fade_in_seconds() -> float:
	return 0.6


func fade_out_seconds() -> float:
	return 0.55


func _process(delta: float) -> void:
	if viewport == null:
		return
	if not is_visible_in_tree():
		viewport.render_target_update_mode = SubViewport.UPDATE_DISABLED
		return
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	step_system(minf(delta, 0.1))
	pass


## The orbit layer is the first child of the overlay, so the ray-cast rings paint beneath the 3D
## viewport: the star and planets still occlude them while the stroke stays a hairline.
func build_orbit_layer() -> void:
	orbit_layer = ColorRect.new()
	orbit_layer.name = "Orbits"
	orbit_layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	orbit_material = ShaderMaterial.new()
	orbit_material.shader = ORBITS_SHADER
	orbit_material.set_shader_parameter("line_width", ORBIT_LINE_WIDTH)
	orbit_layer.material = orbit_material
	overlay.add_child(orbit_layer)
	orbit_layer.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	pass


## Camera matrices only change when the viewport is resized, so the expensive part is synced once
## and every frame only refreshes the theme colour.
func apply_orbit_uniforms() -> void:
	if orbit_material == null or camera == null or viewport == null:
		return
	if not camera.is_inside_tree() or viewport.size.x < 1 or viewport.size.y < 1:
		return
	if not orbit_camera_synced:
		sync_orbit_camera()
	orbit_material.set_shader_parameter("line_color", orbit_line_color())
	pass


func sync_orbit_camera() -> void:
	var projection := camera.get_camera_projection()
	orbit_material.set_shader_parameter("camera_position", camera.global_position)
	orbit_material.set_shader_parameter("camera_basis", camera.global_transform.basis)
	orbit_material.set_shader_parameter("ndc_scale", Vector2(1.0 / projection[0][0], 1.0 / projection[1][1]))
	orbit_material.set_shader_parameter("orbit_count", orbit_normals.size())
	orbit_material.set_shader_parameter("orbit_normals", pad_orbit_normals())
	orbit_material.set_shader_parameter("orbit_radii", pad_orbit_radii())
	orbit_material.set_shader_parameter("orbit_bounds", orbit_screen_bounds())
	orbit_camera_synced = true
	pass


func on_viewport_size_changed() -> void:
	orbit_camera_synced = false
	pass


## Shader uniform arrays keep their declared size, so unused ring slots are padded out.
func pad_orbit_normals() -> PackedVector3Array:
	var normals := orbit_normals.duplicate()
	normals.resize(ORBIT_MAX)
	return normals


func pad_orbit_radii() -> PackedFloat32Array:
	var radii := orbit_radii.duplicate()
	radii.resize(ORBIT_MAX)
	return radii


## Screen bounding box of every ring in normalized window coordinates; padded boxes sit outside
## the screen so they never match a pixel.
func orbit_screen_bounds() -> PackedVector4Array:
	var bounds := PackedVector4Array()
	var screen := Vector2(viewport.size)
	var margin := Vector2.ONE * ORBIT_BOUNDS_MARGIN_PX / screen
	for path: PackedVector3Array in orbit_paths:
		var min_uv := Vector2.ONE
		var max_uv := Vector2.ZERO
		for point: Vector3 in path:
			var uv := camera.unproject_position(point) / screen
			min_uv = min_uv.min(uv)
			max_uv = max_uv.max(uv)
		bounds.append(Vector4(min_uv.x - margin.x, min_uv.y - margin.y, max_uv.x + margin.x, max_uv.y + margin.y))
	while bounds.size() < ORBIT_MAX:
		bounds.append(Vector4(-1.0, -1.0, -1.0, -1.0))
	return bounds


func orbit_line_color() -> Color:
	var overlay_alpha := OVERLAY_ALPHA_DARK if ThemeColor.is_dark_theme() else OVERLAY_ALPHA_LIGHT
	return VisualColor.stroke(VisualColor.appearance_color(ORBIT_COLOR), ORBIT_ALPHA * overlay_alpha)


# ---------------------------------------------------------------------------------------------
# Lifecycle hooks
# ---------------------------------------------------------------------------------------------

func on_agent_start(_session_id: int) -> void:
	ensure_system()
	ending = false
	energy = 0.0
	target_energy = 0.0
	sun_flare = 1.0
	spark_charge = 0.0
	focus_index = 0
	next_tool_planet = 0
	tool_planets.clear()
	clear_probes()
	clear_bursts()
	for planet: Planet in planets:
		planet.flash = 0.0
		planet.halo_target = 0.0
		planet.halo_energy = 0.0
	spawn_burst(Vector3.ZERO, Color(1.0, 0.78, 0.42, 0.85), SUN_RADIUS * 6.0, 1.1)
	pass


func on_agent_end(_session_id: int, error_message: String) -> void:
	ending = true
	sun_flare = 1.0
	for probe: Probe in probes.values():
		spawn_burst(probe.sprite.position, probe.color, planets[probe.planet].radius * 7.0, 0.7)
	clear_probes()
	tool_planets.clear()
	for planet: Planet in planets:
		planet.halo_target = 0.0
	if StringUtils.is_not_blank(error_message):
		spawn_burst(Vector3.ZERO, VisualColor.neon_color(Colors.error), SUN_RADIUS * 8.0, 1.0)
	if not is_inside_tree():
		ending = false
		return
	var started_msec := Time.get_ticks_msec()
	while Time.get_ticks_msec() - started_msec < int(END_SECONDS * 1000.0):
		await get_tree().process_frame
	ending = false
	pass


func on_turn_start(_session_id: int) -> void:
	ensure_system()
	if planets.is_empty():
		return
	focus_index = (focus_index + 1) % planets.size()
	planets[focus_index].flash = 0.55
	planets[focus_index].flash_color = VisualColor.neon_color(ThemeColor.accent_theme_color())
	pass


func on_turn_end(_session_id: int) -> void:
	pass


func on_message_update(_session_id: int, chunk: String, stream_kind: String) -> void:
	ensure_system()
	if chunk.is_empty():
		return
	var gain := SimulationEffect.stream_energy_for_length(chunk.length())
	var reasoning := stream_kind == OpenAiClient.STREAM_KIND_REASONING
	if reasoning:
		gain *= REASONING_ENERGY_SCALE
	target_energy = clampf(target_energy + gain * STREAM_ENERGY_GAIN, 0.0, 1.0)
	spark_charge += gain
	if spark_charge >= SPARK_COST:
		spark_charge = 0.0
		spawn_solar_spark(reasoning)
	if not planets.is_empty():
		var planet := planets[focus_index % planets.size()]
		planet.flash = maxf(planet.flash, 0.18 if reasoning else 0.34)
		planet.flash_color = VisualColor.neon_color(ThemeColor.accent_theme_color())
	pass


func on_message_complete(_session_id: int, _usage: OpenAiUsage) -> void:
	ensure_system()
	sun_flare = maxf(sun_flare, 0.6)
	spawn_burst(Vector3.ZERO, Color(1.0, 0.86, 0.55, 0.8), SUN_RADIUS * 4.2, 0.65)
	pass


func on_tool_execution_start(_session_id: int, tool_call_id: String, tool_name: String, _args: Dictionary[String, Variant]) -> void:
	ensure_system()
	if planets.is_empty():
		return
	var index := claim_planet(tool_call_id)
	tool_planets[tool_call_id] = index
	var planet := planets[index]
	var color := tool_color(tool_name)
	planet.halo_target = 1.0
	planet.flash_color = color
	spawn_probe(tool_call_id, index, color)
	pass


func on_tool_execution_end(_session_id: int, tool_call_id: String, _tool_name: String, agent_tool_result: AgentToolResult) -> void:
	ensure_system()
	var index: int = tool_planets.get(tool_call_id, -1)
	tool_planets.erase(tool_call_id)
	if index < 0 or index >= planets.size():
		release_probe(tool_call_id, Color.WHITE)
		return
	var planet := planets[index]
	planet.halo_target = 0.0 if not has_running_tool(index) else 1.0
	var failed := agent_tool_result != null and agent_tool_result.is_error
	planet.flash = 1.0
	planet.flash_color = VisualColor.neon_color(Colors.error if failed else Colors.success)
	release_probe(tool_call_id, planet.flash_color)
	spawn_burst(planet_position(planet), planet.flash_color, planet.radius * (9.0 if failed else 6.5), 0.75)
	pass


# ---------------------------------------------------------------------------------------------
# Event helpers
# ---------------------------------------------------------------------------------------------

## Round-robin planet assignment so parallel tools land on different worlds.
func claim_planet(tool_call_id: String) -> int:
	if tool_planets.has(tool_call_id):
		return tool_planets[tool_call_id]
	var index := next_tool_planet % planets.size()
	next_tool_planet += 1
	return index


func has_running_tool(index: int) -> bool:
	for assigned: int in tool_planets.values():
		if assigned == index:
			return true
	return false


func tool_color(tool_name: String) -> Color:
	var accent := ThemeColor.accent_theme_color()
	var hue_offset := float(absi(tool_name.hash()) % 360) / 360.0 * 0.25
	return VisualColor.neon_color(accent, hue_offset, 0.85)


func spawn_probe(tool_call_id: String, index: int, color: Color) -> void:
	var probe := Probe.new()
	probe.planet = index
	probe.color = color
	probe.sprite = make_glow_sprite(color, planets[index].radius * 1.6)
	probe.sprite.position = Vector3.ZERO
	effects_root.add_child(probe.sprite)
	probes[tool_call_id] = probe
	pass


func release_probe(tool_call_id: String, color: Color) -> void:
	var probe: Probe = probes.get(tool_call_id)
	if probe == null:
		return
	probes.erase(tool_call_id)
	spawn_burst(probe.sprite.position, color, planets[probe.planet].radius * 3.4, 0.5)
	probe.sprite.queue_free()
	pass


func clear_probes() -> void:
	for probe: Probe in probes.values():
		if is_instance_valid(probe.sprite):
			probe.sprite.queue_free()
	probes.clear()
	pass


func spawn_solar_spark(reasoning: bool) -> void:
	var direction := Vector3(rng.randf_range(-1.0, 1.0), rng.randf_range(-0.35, 0.35), rng.randf_range(-1.0, 1.0)).normalized()
	var distance := rng.randf_range(0.4, 1.0) * (1.4 if reasoning else 2.6)
	var tint := VisualColor.neon_color(ThemeColor.accent_theme_color()) if reasoning else Color(1.0, 0.72, 0.34)
	spawn_burst(direction * distance, tint, 0.5 + rng.randf() * 0.7, 0.55)
	pass


func spawn_burst(position: Vector3, color: Color, world_size: float, duration: float) -> void:
	if bursts.size() >= MAX_BURSTS:
		var oldest: Burst = bursts.pop_front()
		if is_instance_valid(oldest.sprite):
			oldest.sprite.queue_free()
	var burst := Burst.new()
	burst.color = color
	burst.duration = duration
	burst.end_scale = 1.0 + world_size * 0.35
	burst.start_scale = 0.35
	burst.sprite = make_glow_sprite(color, world_size)
	burst.sprite.position = position
	effects_root.add_child(burst.sprite)
	bursts.append(burst)
	pass


func clear_bursts() -> void:
	for burst: Burst in bursts:
		if is_instance_valid(burst.sprite):
			burst.sprite.queue_free()
	bursts.clear()
	pass


# ---------------------------------------------------------------------------------------------
# Simulation
# ---------------------------------------------------------------------------------------------

func step_system(delta: float) -> void:
	if viewport == null:
		return
	clock += delta
	target_energy = maxf(0.0, target_energy - ENERGY_DECAY_PER_SECOND * delta)
	energy = lerpf(energy, target_energy, minf(1.0, delta * ENERGY_FOLLOW_RATE))
	sun_flare = maxf(0.0, sun_flare - delta * FLARE_DECAY_PER_SECOND)
	var speed := 0.75 + energy * ORBIT_SPEED_GAIN + (ENDING_SPEED_GAIN if ending else 0.0)
	orbit_gain = lerpf(orbit_gain, speed, minf(1.0, delta * 2.5))
	belt_angle = fposmod(belt_angle + delta * 0.05 * orbit_gain, TAU)
	sun_body.rotation.y = fposmod(sun_body.rotation.y + delta * (0.05 + energy * 0.12), TAU)
	if belt_root != null:
		belt_root.rotation.y = belt_angle
	for planet: Planet in planets:
		planet.orbit_angle = fposmod(planet.orbit_angle + planet.orbit_speed * orbit_gain * delta, TAU)
		planet.pivot.rotation.y = planet.orbit_angle
		planet.body.rotation.y = fposmod(planet.body.rotation.y + planet.axis_spin * delta * (1.0 + energy * 1.6), TAU)
		planet.flash = maxf(0.0, planet.flash - delta * FLASH_DECAY_PER_SECOND)
		planet.halo_energy = lerpf(planet.halo_energy, planet.halo_target, minf(1.0, delta * HALO_FOLLOW_RATE))
	step_probes(delta)
	step_bursts(delta)
	apply_visuals()
	pass


## Planet position in system space. Reads transforms directly so unit tests work before the
## scene enters the tree, where [member Node3D.global_position] would log an error.
func planet_position(planet: Planet) -> Vector3:
	return planet.pivot.transform * planet.anchor.position


func step_probes(delta: float) -> void:
	for probe: Probe in probes.values():
		var planet := planets[probe.planet]
		var target := planet_position(planet)
		probe.progress = minf(1.0, probe.progress + delta / PROBE_TRAVEL_SECONDS)
		if probe.progress < 1.0:
			probe.sprite.position = target * smoothstep(0.0, 1.0, probe.progress)
		else:
			probe.orbit_angle = fposmod(probe.orbit_angle + delta * PROBE_ORBIT_SPEED, TAU)
			var orbit := Vector3(cos(probe.orbit_angle), 0.32 * sin(probe.orbit_angle * 1.4), sin(probe.orbit_angle))
			probe.sprite.position = target + orbit * planet.radius * 2.1
		probe.trail_clock += delta
		if probe.trail_clock >= PROBE_TRAIL_SECONDS:
			probe.trail_clock = 0.0
			spawn_burst(probe.sprite.position, probe.color, planet.radius * 1.7, 0.34)
	pass


func step_bursts(delta: float) -> void:
	for index in range(bursts.size() - 1, -1, -1):
		var burst := bursts[index]
		burst.life += delta
		var progress := burst.life / burst.duration
		if progress >= 1.0:
			if is_instance_valid(burst.sprite):
				burst.sprite.queue_free()
			bursts.remove_at(index)
			continue
		burst.sprite.scale = Vector3.ONE * lerpf(burst.start_scale, burst.end_scale, sqrt(progress))
		burst.sprite.modulate = Color(burst.color.r, burst.color.g, burst.color.b, lerpf(1.0, 0.0, progress) * burst.color.a)
	pass


## Pushes smooth state values into shader uniforms and sprite transforms.
func apply_visuals() -> void:
	if overlay == null or sun_body == null:
		return
	var dark := ThemeColor.is_dark_theme()
	overlay.modulate.a = OVERLAY_ALPHA_DARK if dark else OVERLAY_ALPHA_LIGHT
	# On a light desktop the starfield becomes fine ink specks, the halo fades, and the fill
	# light lifts night sides so planets do not read as black discs.
	if starfield_material != null:
		starfield_material.set_shader_parameter("star_color", Color(0.90, 0.95, 1.0) if dark else Color(0.34, 0.39, 0.50))
		starfield_material.set_shader_parameter("coverage", 0.40 if dark else 0.22)
	if environment != null:
		environment.ambient_light_energy = 0.45 if dark else 0.95
		environment.ambient_light_color = Color(0.16, 0.19, 0.28) if dark else Color(0.62, 0.66, 0.80)
	if fill_light != null:
		fill_light.light_energy = 0.45 if dark else 0.9
	if belt_material != null:
		belt_material.albedo_color = Color(0.42, 0.38, 0.34) if dark else Color(0.88, 0.88, 0.90)
	var flare := sun_flare
	if sun_body_material != null:
		sun_body_material.set_shader_parameter("emit", SUN_EMIT_BASE + energy * SUN_EMIT_STREAM + flare * 0.9)
	if sun_corona_material != null:
		sun_corona_material.set_shader_parameter("intensity", 4.0 + energy * 4.0 + flare * 9.0)
		sun_corona_material.set_shader_parameter("alpha", 0.16 + energy * 0.1)
	var glow_scale := 1.0 + energy * 0.16 + flare * 0.3 + sin(clock * 1.6) * 0.02
	if sun_glow != null:
		sun_glow.scale = Vector3.ONE * glow_scale
		sun_glow.modulate = Color(1.0, 0.68, 0.32, (0.85 + flare * 0.15) if dark else 0.3)
	for planet: Planet in planets:
		apply_planet_visuals(planet)
	if starfield_material != null:
		starfield_material.set_shader_parameter("brightness", (2.0 + energy * 1.3) if dark else 1.1)
	apply_orbit_uniforms()
	pass


func apply_planet_visuals(planet: Planet) -> void:
	var flash := clampf(planet.flash, 0.0, 1.0)
	var halo := clampf(planet.halo_energy, 0.0, 1.0)
	if planet.body_material != null:
		planet.body_material.set_shader_parameter("emit", flash * 0.25)
	if planet.atmosphere_material != null:
		planet.atmosphere_material.set_shader_parameter("intensity", 4.0 + flash * 5.0 + halo * 2.0)
	if planet.cloud_material != null:
		planet.cloud_material.set_shader_parameter("speed", 0.005 + energy * 0.012)
	if planet.halo != null:
		var pulse := 0.72 + 0.28 * sin(clock * 4.0)
		planet.halo.modulate = Color(planet.flash_color.r, planet.flash_color.g, planet.flash_color.b, clampf(halo * 0.8 * pulse + flash * 0.6, 0.0, 1.0))
		planet.halo.scale = Vector3.ONE * (1.0 + halo * 0.12 + flash * 0.35)
		planet.halo.visible = planet.halo.modulate.a > 0.01
	pass


# ---------------------------------------------------------------------------------------------
# Scene construction
# ---------------------------------------------------------------------------------------------

func ensure_system() -> void:
	if viewport != null:
		return
	build_system()
	pass


func build_system() -> void:
	overlay = Control.new()
	overlay.name = "SolarOverlay"
	overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(overlay)
	overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	build_orbit_layer()

	container = SubViewportContainer.new()
	container.name = "SolarViewport"
	container.stretch = true
	container.stretch_shrink = RENDER_SHRINK
	container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	overlay.add_child(container)
	container.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)

	viewport = SubViewport.new()
	viewport.name = "SolarScene"
	viewport.transparent_bg = true
	viewport.own_world_3d = true
	viewport.msaa_3d = Viewport.MSAA_2X
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	container.add_child(viewport)
	viewport.size_changed.connect(on_viewport_size_changed)

	glow_texture = make_radial_texture()
	halo_texture = make_ring_texture()
	unit_sphere = make_unit_sphere()
	build_environment()
	build_camera()
	build_root()
	build_starfield()
	build_sun()
	build_planets()
	build_belt()
	apply_visuals()
	pass


func build_environment() -> void:
	environment = Environment.new()
	environment.background_mode = Environment.BG_CLEAR_COLOR
	environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	environment.ambient_light_color = Color(0.16, 0.19, 0.28)
	environment.ambient_light_energy = 0.45
	environment.glow_enabled = true
	environment.glow_intensity = 1.15
	environment.glow_bloom = 0.22
	environment.glow_hdr_threshold = 0.85
	environment.glow_blend_mode = Environment.GLOW_BLEND_MODE_ADDITIVE
	var world := WorldEnvironment.new()
	world.environment = environment
	viewport.add_child(world)
	# The star is the light source: planets are lit radially, near worlds hotter than far ones.
	var sun_light := OmniLight3D.new()
	sun_light.light_color = Color(1.0, 0.93, 0.82)
	sun_light.light_energy = 6.0
	sun_light.omni_range = 26.0
	sun_light.omni_attenuation = 0.45
	sun_light.shadow_enabled = false
	viewport.add_child(sun_light)
	fill_light = DirectionalLight3D.new()
	fill_light.light_color = Color(0.55, 0.68, 1.0)
	fill_light.light_energy = 0.45
	fill_light.shadow_enabled = false
	fill_light.transform = Transform3D(Basis.looking_at(Vector3(0.35, -0.25, -1.0), Vector3.UP), Vector3.ZERO)
	viewport.add_child(fill_light)
	pass


func build_camera() -> void:
	camera = Camera3D.new()
	camera.fov = CAMERA_FOV
	camera.near = 0.05
	camera.far = 260.0
	camera.transform = Transform3D(Basis.looking_at(CAMERA_TARGET - CAMERA_POSITION, Vector3.UP), CAMERA_POSITION)
	viewport.add_child(camera)
	pass


func build_root() -> void:
	system_root = Node3D.new()
	system_root.name = "System"
	viewport.add_child(system_root)
	effects_root = Node3D.new()
	effects_root.name = "Effects"
	viewport.add_child(effects_root)
	pass


func build_starfield() -> void:
	starfield_material = ShaderMaterial.new()
	starfield_material.shader = STARFIELD_SHADER
	var mesh := SphereMesh.new()
	mesh.radius = STARFIELD_RADIUS
	mesh.height = STARFIELD_RADIUS * 2.0
	mesh.radial_segments = 48
	mesh.rings = 24
	mesh.material = starfield_material
	var stars := MeshInstance3D.new()
	stars.name = "Starfield"
	stars.mesh = mesh
	stars.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	viewport.add_child(stars)
	pass


func build_sun() -> void:
	sun_body_material = make_body_material(BODY_PRESETS["star"])
	sun_body = MeshInstance3D.new()
	sun_body.name = "Sun"
	sun_body.mesh = unit_sphere
	sun_body.material_override = sun_body_material
	sun_body.scale = Vector3.ONE * SUN_RADIUS
	sun_body.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	system_root.add_child(sun_body)

	sun_corona_material = make_atmosphere_material(ATMOSPHERE_PRESETS["star"])
	sun_corona = MeshInstance3D.new()
	sun_corona.name = "SunCorona"
	sun_corona.mesh = unit_sphere
	sun_corona.material_override = sun_corona_material
	sun_corona.scale = Vector3.ONE * SUN_RADIUS * SUN_CORONA_SCALE
	sun_corona.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	system_root.add_child(sun_corona)

	var to_camera := (CAMERA_POSITION - CAMERA_TARGET).normalized()
	sun_glow = make_glow_sprite(Color(1.0, 0.68, 0.32, 0.85), SUN_GLOW_SIZE)
	sun_glow.name = "SunGlow"
	sun_glow.position = -to_camera * SUN_GLOW_DEPTH
	system_root.add_child(sun_glow)
	pass


func build_planets() -> void:
	for spec: Dictionary in PLANET_SPECS:
		var radius := float(spec["radius"])
		var planet := Planet.new()
		planet.radius = radius
		planet.orbit_speed = float(spec["orbit_speed"])
		planet.axis_spin = float(spec["spin"])
		planet.orbit_angle = rng.randf_range(0.0, TAU)
		planet.flash_color = Color(1.0, 0.85, 0.6, 1.0)

		var inclination := Node3D.new()
		inclination.rotation.x = float(spec["inclination"])
		system_root.add_child(inclination)
		orbit_paths.append(make_orbit_path(inclination.transform, float(spec["orbit"])))
		orbit_normals.append((inclination.transform.basis * Vector3.UP).normalized())
		orbit_radii.append(float(spec["orbit"]))

		planet.pivot = Node3D.new()
		inclination.add_child(planet.pivot)

		planet.anchor = Node3D.new()
		planet.anchor.position = Vector3(float(spec["orbit"]), 0.0, 0.0)
		planet.anchor.rotation.z = float(spec["tilt"])
		planet.pivot.add_child(planet.anchor)

		planet.body_material = make_body_material(BODY_PRESETS[str(spec["body"])])
		if spec.has("clouds"):
			planet.cloud_material = make_cloud_material(CLOUD_PRESETS[str(spec["clouds"])])
			planet.body_material.next_pass = planet.cloud_material

		planet.body = MeshInstance3D.new()
		planet.body.name = "Planet"
		planet.body.mesh = unit_sphere
		planet.body.material_override = planet.body_material
		planet.body.scale = Vector3.ONE * radius
		planet.body.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		planet.anchor.add_child(planet.body)

		if spec.has("atmosphere"):
			planet.atmosphere_material = make_atmosphere_material(ATMOSPHERE_PRESETS[str(spec["atmosphere"])])
			var atmosphere := MeshInstance3D.new()
			atmosphere.name = "Atmosphere"
			atmosphere.mesh = unit_sphere
			atmosphere.material_override = planet.atmosphere_material
			atmosphere.scale = Vector3.ONE * radius * 1.035
			atmosphere.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			planet.anchor.add_child(atmosphere)

		if bool(spec.get("ring", false)):
			planet.anchor.add_child(make_ring(radius))

		planet.halo = make_halo_sprite(radius)
		planet.anchor.add_child(planet.halo)

		planet.pivot.rotation.y = planet.orbit_angle
		planets.append(planet)
	pass


func build_belt() -> void:
	var rock := SphereMesh.new()
	rock.radius = 1.0
	rock.height = 2.0
	rock.radial_segments = 6
	rock.rings = 3
	belt_material = StandardMaterial3D.new()
	belt_material.albedo_color = Color(0.42, 0.38, 0.34)
	belt_material.roughness = 0.9
	rock.material = belt_material
	var multimesh := MultiMesh.new()
	multimesh.transform_format = MultiMesh.TRANSFORM_3D
	multimesh.mesh = rock
	multimesh.instance_count = BELT_COUNT
	for index in range(BELT_COUNT):
		var angle := rng.randf_range(0.0, TAU)
		var distance := rng.randf_range(BELT_INNER, BELT_OUTER)
		var height := rng.randf_range(-0.14, 0.14)
		var size := rng.randf_range(0.008, 0.024)
		var basis := Basis.from_euler(Vector3(rng.randf_range(0.0, TAU), rng.randf_range(0.0, TAU), rng.randf_range(0.0, TAU))).scaled(Vector3.ONE * size)
		multimesh.set_instance_transform(index, Transform3D(basis, Vector3(cos(angle) * distance, height, sin(angle) * distance)))
	belt_root = MultiMeshInstance3D.new()
	belt_root.name = "AsteroidBelt"
	belt_root.multimesh = multimesh
	belt_root.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	system_root.add_child(belt_root)
	pass


# ---------------------------------------------------------------------------------------------
# Materials, meshes, textures
# ---------------------------------------------------------------------------------------------

func make_unit_sphere() -> SphereMesh:
	var mesh := SphereMesh.new()
	mesh.radius = 1.0
	mesh.height = 2.0
	mesh.radial_segments = 48
	mesh.rings = 24
	return mesh


func make_body_material(preset: Dictionary) -> ShaderMaterial:
	var material := ShaderMaterial.new()
	material.shader = BODY_SHADER
	var colors: Array = preset["colors"]
	var thresholds: Array = preset["thresholds"]
	for index in range(colors.size()):
		material.set_shader_parameter("color_%d" % (index + 1), colors[index])
		material.set_shader_parameter("color_%d_treshold" % (index + 1), float(thresholds[index]))
	material.set_shader_parameter("color_1_roughness", float(preset["roughness"]))
	material.set_shader_parameter("color_1_emit", false)
	material.set_shader_parameter("noise", preset["noise"])
	material.set_shader_parameter("noise_scale", float(preset["noise_scale"]))
	material.set_shader_parameter("noise_gaseous", bool(preset["gaseous"]))
	material.set_shader_parameter("noise_gaseous_speed", float(preset["gaseous_speed"]))
	material.set_shader_parameter("emit", float(preset["emit"]))
	return material


func make_atmosphere_material(preset: Dictionary) -> ShaderMaterial:
	var material := ShaderMaterial.new()
	material.shader = ATMOSPHERE_SHADER
	material.set_shader_parameter("color_1", preset["color_1"])
	material.set_shader_parameter("color_2", preset["color_2"])
	material.set_shader_parameter("alpha", float(preset["alpha"]))
	material.set_shader_parameter("amount", float(preset["amount"]))
	material.set_shader_parameter("intensity", float(preset["intensity"]))
	material.set_shader_parameter("emit", bool(preset["emit"]))
	material.render_priority = 1
	return material


func make_cloud_material(preset: Dictionary) -> ShaderMaterial:
	var material := ShaderMaterial.new()
	material.shader = CLOUDS_SHADER
	material.set_shader_parameter("noise_texture", preset["noise"])
	material.set_shader_parameter("speed", float(preset["speed"]))
	material.set_shader_parameter("brightness", float(preset["brightness"]))
	material.set_shader_parameter("threshold", float(preset["threshold"]))
	material.set_shader_parameter("fluffiness", float(preset["fluffiness"]))
	material.render_priority = 2
	return material


func make_ring_material() -> ShaderMaterial:
	var material := ShaderMaterial.new()
	material.shader = RING_SHADER
	material.set_shader_parameter("inner_color", Color(0.78, 0.71, 0.60))
	material.set_shader_parameter("outer_color", Color(0.95, 0.91, 0.79))
	material.set_shader_parameter("inner_radius", 0.56)
	material.set_shader_parameter("outer_radius", 0.99)
	material.set_shader_parameter("opacity", 0.72)
	material.set_shader_parameter("band_frequency", 46.0)
	material.set_shader_parameter("band_contrast", 0.6)
	material.set_shader_parameter("brightness", 1.15)
	return material


func make_ring(planet_radius: float) -> MeshInstance3D:
	var quad := QuadMesh.new()
	quad.size = Vector2(2.0, 2.0)
	var ring := MeshInstance3D.new()
	ring.name = "Ring"
	ring.mesh = quad
	ring.material_override = make_ring_material()
	ring.rotation.x = -PI * 0.5
	ring.scale = Vector3.ONE * planet_radius * 2.5
	ring.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	return ring


## Samples one orbit ellipse in world space. The overlay projects these points to screen space
## every frame, so the stroke width never depends on the ring's viewing angle.
func make_orbit_path(orbit_transform: Transform3D, radius: float) -> PackedVector3Array:
	var path := PackedVector3Array()
	for index in range(ORBIT_SAMPLES + 1):
		var direction := Vector2.from_angle(TAU * float(index) / float(ORBIT_SAMPLES))
		path.append(orbit_transform * (Vector3(direction.x, 0.0, direction.y) * radius))
	return path


func make_halo_sprite(planet_radius: float) -> Sprite3D:
	var sprite := Sprite3D.new()
	sprite.texture = halo_texture
	sprite.pixel_size = planet_radius * 5.0 / float(halo_texture.get_height())
	sprite.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	sprite.shaded = false
	sprite.transparent = true
	sprite.no_depth_test = false
	sprite.render_priority = 3
	sprite.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	sprite.modulate = Color(1.0, 1.0, 1.0, 0.0)
	return sprite


func make_glow_sprite(color: Color, world_size: float) -> Sprite3D:
	var sprite := Sprite3D.new()
	sprite.texture = glow_texture
	sprite.pixel_size = world_size / float(glow_texture.get_height())
	sprite.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	sprite.shaded = false
	sprite.transparent = true
	sprite.no_depth_test = false
	sprite.render_priority = 4
	sprite.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	sprite.modulate = color
	return sprite


## Soft white falloff used by the star glow, probes, trails and burst flashes.
func make_radial_texture() -> ImageTexture:
	var size := 128
	var image := Image.create(size, size, false, Image.FORMAT_RGBA8)
	var center := float(size) * 0.5
	for y in range(size):
		for x in range(size):
			var radius := Vector2(float(x) + 0.5 - center, float(y) + 0.5 - center).length() / center
			var alpha := clampf(1.0 - radius, 0.0, 1.0)
			alpha = alpha * alpha * (0.25 + 0.75 * alpha)
			image.set_pixel(x, y, Color(1.0, 1.0, 1.0, alpha))
	return ImageTexture.create_from_image(image)


## Thin camera-facing ring used as a target lock around a planet while its tool runs.
func make_ring_texture() -> ImageTexture:
	var size := 128
	var image := Image.create(size, size, false, Image.FORMAT_RGBA8)
	var center := float(size) * 0.5
	for y in range(size):
		for x in range(size):
			var radius := Vector2(float(x) + 0.5 - center, float(y) + 0.5 - center).length() / center
			var inner := smoothstep(0.80, 0.845, radius)
			var outer := 1.0 - smoothstep(0.925, 0.975, radius)
			var ticks := 0.72 + 0.28 * cos(atan2(float(y) + 0.5 - center, float(x) + 0.5 - center) * 32.0)
			image.set_pixel(x, y, Color(1.0, 1.0, 1.0, clampf(inner * outer * ticks, 0.0, 1.0)))
	return ImageTexture.create_from_image(image)
