static func entry_from_value(value: int) -> Dictionary:
	for raw_entry in ENTRIES:
		var upper_index: int = raw_entry[2]
		var lower_index: int = raw_entry[3]
		var entry_value: int = TRIGRAM_VALUES[upper_index] | (TRIGRAM_VALUES[lower_index] << 3)
		if entry_value == value:
			return build_entry(raw_entry, entry_value)
	return {}


static func entry_from_number(number: int) -> Dictionary:
	if number < 1 or number > ENTRIES.size():
		return {}
	var raw_entry: Array = ENTRIES[number - 1]
	var upper_index: int = raw_entry[2]
	var lower_index: int = raw_entry[3]
	var value: int = TRIGRAM_VALUES[upper_index] | (TRIGRAM_VALUES[lower_index] << 3)
	return build_entry(raw_entry, value)


static func build_entry(raw_entry: Array, value: int) -> Dictionary:
	var number: int = raw_entry[0]
	var name: String = raw_entry[1]
	var upper_index: int = raw_entry[2]
	var lower_index: int = raw_entry[3]
	var full_name := full_name_for(name, upper_index, lower_index)
	return {
		"number": number,
		"value": value,
		"name": name,
		"full_name": full_name,
		"symbol": String.chr(0x4DBF + number),
		"upper_name": TRIGRAM_NAMES[upper_index],
		"upper_element": TRIGRAM_ELEMENTS[upper_index],
		"lower_name": TRIGRAM_NAMES[lower_index],
		"lower_element": TRIGRAM_ELEMENTS[lower_index],
		"judgment": raw_entry[4],
		"image": raw_entry[5],
	}


static func full_name_for(name: String, upper_index: int, lower_index: int) -> String:
	if upper_index == lower_index:
		return name + "为" + TRIGRAM_ELEMENTS[upper_index]
	return TRIGRAM_ELEMENTS[upper_index] + TRIGRAM_ELEMENTS[lower_index] + name
