{
    "name": "gai-web-server",
    "version": "0.1.1",
    "private": true,
    "description": "Run from repo root via ./README.md (.dependency/node/npm.cmd --prefix web).",
    "engines": {
        "node": "24.22.0"
    },
    "type": "module",
    "scripts": {
        "start": "tsx src/server.ts",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test test/**/*.test.ts",
        "postinstall": "node --import dotenv/config ./node_modules/playwright/cli.js install chromium"
    },
    "dependencies": {
        "@modelcontextprotocol/client": "^2.4.0",
        "axios": "^1.20.0",
        "defuddle": "^0.19.5",
        "dotenv": "^18.0.8",
        "openai": "^7.36.0",
        "playwright": "^1.64.1",
        "undici": "^8.12.2"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
