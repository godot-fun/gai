# Rename to `.env` in this folder (git-ignored, unlike this template). All keys are optional, defaults below.
# The agent also reads HOST / PORT / REQUEST_TIMEOUT_MS, so keep values on their own line.

# ----------------------------------------------------------------------------------------------------------------------

# API bind address and port. Loopback only, the API has no auth. Default 127.0.0.1 / 3000.
HOST = 127.0.0.1
PORT = 33714

# Per-request cap, and the time budget of one /browser/action call. Default 45000.
REQUEST_TIMEOUT_MS = 45000

# ----------------------------------------------------------------------------------------------------------------------

# Browser proxy, empty = direct. Setting it also moves /search from Bing to Google.
BROWSER_PROXY = http://127.0.0.1:10809

# false shows the browser window; a manual login then persists in the profile. Default true.
BROWSER_HEADLESS = false

# Page load and `goto` timeout. Default 30000.
NAVIGATION_TIMEOUT_MS = 30000

# ----------------------------------------------------------------------------------------------------------------------

# Camoufox download and cache root. Default: the OS value.
LOCALAPPDATA = .app_data

# Firefox profile with cookies and logins. Default ./.user_data.
CAMOUFOX_USER_DATA_DIR = .user_data

# ----------------------------------------------------------------------------------------------------------------------

# MCP server list; a missing file disables MCP. Default mcp.json.
# MCP_CONFIG_PATH = mcp.json

# ----------------------------------------------------------------------------------------------------------------------

# Reserved: not read by web/src today.
AI_API_KEY =
AI_MODEL = deepseek-chat
AI_BASE_URL = "https://api.deepseek.com"
